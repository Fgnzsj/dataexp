# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets or personal URLs.

# Web3Forms access key (get one free at https://web3forms.com).
# Required at build time for the contact form to submit anywhere; if unset,
# the form renders with an empty access_key and submissions will fail.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=<your-web3forms-key>

# Canonical site URL used for metadata (canonical link, Open Graph, JSON-LD,
# robots.txt, sitemap.xml). For a GitHub Pages project site this is your
# GitHub Pages URL including the repo path.
NEXT_PUBLIC_SITE_URL=https://<your-user>.github.io/dataexp

# Next.js basePath/assetPrefix. Use the GitHub Pages repo path (e.g. /dataexp)
# for a project site, or an empty string ("") for a custom domain / user site.
NEXT_PUBLIC_BASE_PATH=/dataexp
